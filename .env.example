# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_PUBSUB_CHANNEL=slack-relay-reaction-added
REDIS_LIST_NAME=poppit-commands
REDIS_OUTPUT_CHANNEL=poppit:command-output
REDIS_REACTION_LIST=slack_reactions

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Deployment Configuration
BASE_DIR=/app/repos

# Combined Configuration File Path (YAML format)
# Contains allowedRepos, legacyDockerApps, and dockerOverride fields
# If not set, vibeDeployConfig.yml in the root directory is checked by default
VIBEDEPLY_CONFIG=

# Legacy Configuration Options (Deprecated - use VIBEDEPLY_CONFIG instead)
ALLOWED_REPOS_CONFIG=
LEGACY_DOCKER_APPS_CONFIG=

# Logging Configuration
# Valid values: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO
